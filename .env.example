# Copy to .env.local (or `vercel env pull .env.local`). Never commit real values.

# --- Auth ---
NEXTAUTH_URL=https://www.physiotohome.com
NEXTAUTH_SECRET=            # openssl rand -base64 32
ADMIN_EMAIL=                # only this address can reach /admin

# --- Database (Neon Postgres) ---
POSTGRES_URL=               # pooled connection string
POSTGRES_URL_NON_POOLING=   # direct connection string
DB_CONNECTION_MODE=         # see src/lib/db.ts

# --- Cliniko ---
CLINIKO_API_KEY=
CLINIKO_API_BASE=           # shard-specific, e.g. https://api.au4.cliniko.com/v1
CLINIKO_BUSINESS_ID=
CLINIKO_USER_AGENT=         # optional

# --- Email (Zoho SMTP) ---
ZOHO_SMTP_HOST=             # optional, defaults to smtp.zoho.com.au
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
ZOHO_SMTP_FROM=

# --- Diagnostics (leave unset normally) ---
# DEBUG_LOGS=1              # verbose db/email logging; includes staff emails + patient IDs
